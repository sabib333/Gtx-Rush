# ============================================================
# GTX Rush — Production Environment Configuration
# ============================================================
# ALL values must come from a secrets manager or deployment platform.
# Never hard-code values — use variable references.
# ============================================================

# === Environment ===
NODE_ENV=production

# === Database ===
DATABASE_URL=${DATABASE_URL}
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000

# === Redis ===
REDIS_URL=${REDIS_URL}
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_BOT_USERNAME=gtxrushbot

# === Authentication ===
JWT_SECRET=${JWT_SECRET}
ADMIN_JWT_SECRET=${ADMIN_JWT_SECRET}
SESSION_SECRET=${SESSION_SECRET}

# === Telegram Webhook ===
TELEGRAM_WEBHOOK_SECRET=${TELEGRAM_WEBHOOK_SECRET}

# === Mini App URL ===
MINI_APP_URL=${MINI_APP_URL}

# === Webhook ===
WEBHOOK_SECRET=${WEBHOOK_SECRET}

# === Payment ===
STARS_PAYMENT_TOKEN=${STARS_PAYMENT_TOKEN}

# === App ===
API_PORT=3001
CORS_ORIGIN=${CORS_ORIGIN}

# === Security ===
DEV_TELEGRAM_MOCK=false

# === Logging ===
LOG_LEVEL=info

# === Rate Limiting ===
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_GAME=20
RATE_LIMIT_ADMIN=200

# === Infrastructure ===
NODE_OPTIONS=--max-old-space-size=768

# === Monitoring ===
ENABLE_METRICS=true
ENABLE_TRACING=false

# === Backups ===
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"
