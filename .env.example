# ============================================================
# GTX Rush — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gtx_rush

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=8892021364:AAEHWQzcd-3WrOkGjsZpAH444AxFL7OOTbQ
TELEGRAM_BOT_USERNAME=gtxrushbot

# === Telegram Webhook (production) ===
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# === Mini App URL (production) ===
MINI_APP_URL=https://your-domain.com

# === Authentication ===
JWT_SECRET=change_me_to_random_64_char_string

# === Session (production) ===
SESSION_SECRET=change_me_to_another_random_64_char_string

# === Admin ===
ADMIN_JWT_SECRET=change_me_to_another_random_64_char_string

# === Telegram Stars (Monetization — future) ===
STARS_PAYMENT_TOKEN=your_stars_payment_token

# === Webhook ===
WEBHOOK_SECRET=your_webhook_secret_here

# === App ===
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# === Development Only ===
# Set to "true" to enable mock Telegram authentication.
# NEVER enable this in production.
DEV_TELEGRAM_MOCK=false
