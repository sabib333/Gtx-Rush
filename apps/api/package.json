{
  "name": "@gtx-rush/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@gtx-rush/analytics": "workspace:*",
    "@gtx-rush/config": "workspace:*",
    "@gtx-rush/game-engine": "workspace:*",
    "@gtx-rush/game-quiz-rush": "workspace:^",
    "@gtx-rush/game-reaction-rush": "workspace:^",
    "@gtx-rush/game-tap-rush": "workspace:^",
    "@gtx-rush/telegram": "workspace:*",
    "@gtx-rush/types": "workspace:*",
    "@gtx-rush/validation": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "nanoid": "^5.0.0",
    "postgres": "^3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3"
  }
}
