# ============================================================
# GTX Rush — Development Environment Configuration
# ============================================================
# Copy to .env and customize. Never commit .env to version control.
# ============================================================

# === Environment ===
NODE_ENV=development

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gtx_rush

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_dev_bot_token
TELEGRAM_BOT_USERNAME=gtxrushbot

# === Authentication ===
JWT_SECRET=dev_jwt_secret_min_32_chars_long_change_me
ADMIN_JWT_SECRET=dev_admin_jwt_secret_min_32_chars_long_change_me
SESSION_SECRET=dev_session_secret_min_32_chars_long_change_me

# === Telegram Webhook (not needed in dev) ===
TELEGRAM_WEBHOOK_SECRET=

# === Mini App URL (not needed in dev) ===
MINI_APP_URL=

# === Webhook ===
WEBHOOK_SECRET=dev_webhook_secret

# === Payment (not needed in dev) ===
STARS_PAYMENT_TOKEN=

# === App ===
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# === Development Only ===
# Enable mock Telegram authentication (NEVER in production)
DEV_TELEGRAM_MOCK=true

# === Logging ===
LOG_LEVEL=debug

# === Infrastructure (dev uses Docker Compose) ===
REDIS_HOST=localhost
REDIS_PORT=6379
