{
  "name": "gtx-rush",
  "version": "0.1.0",
  "private": true,
  "description": "GTX Rush — Play. Compete. Rise. ⚡",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @gtx-rush/api db:migrate",
