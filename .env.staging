# ============================================================
# GTX Rush — Staging Environment Configuration
# ============================================================
# Staging mirrors production but uses test data.
# Never use real payment credentials in staging.
# ============================================================

# === Environment ===
NODE_ENV=staging

# === Database ===
DATABASE_URL=postgresql://gtx_user:${DB_PASSWORD}@${DB_HOST}:5432/gtx_rush_staging

# === Redis ===
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_BOT_USERNAME=gtxrushbot

# === Authentication ===
JWT_SECRET=${JWT_SECRET}
ADMIN_JWT_SECRET=${ADMIN_JWT_SECRET}
SESSION_SECRET=${SESSION_SECRET}

# === Telegram Webhook ===
TELEGRAM_WEBHOOK_SECRET=${TELEGRAM_WEBHOOK_SECRET}

# === Mini App URL ===
MINI_APP_URL=https://staging-gtxrush.example.com

# === Webhook ===
WEBHOOK_SECRET=${WEBHOOK_SECRET}

# === Payment (TEST credentials only) ===
STARS_PAYMENT_TOKEN=${STARS_PAYMENT_TOKEN}

# === App ===
API_PORT=3001
CORS_ORIGIN=https://staging-gtxrush.example.com

# === Security ===
DEV_TELEGRAM_MOCK=false

# === Logging ===
LOG_LEVEL=info

# === Infrastructure ===
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379

# === Rate Limiting ===
RATE_LIMIT_GENERAL=200
RATE_LIMIT_AUTH=20
RATE_LIMIT_GAME=30
